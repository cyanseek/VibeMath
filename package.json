{
  "name": "vibemath",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "vibemath": "./bin/vibemath.mjs"
  },
  "description": "The live, agent-readable frontier of AI mathematics.",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync": "tsx scripts/sync.ts",
    "validate": "tsx scripts/validate-data.ts",
    "derive": "tsx scripts/build-derived-feeds.ts",
    "schemas": "tsx scripts/generate-schemas.ts",
    "dev": "astro dev",
    "build": "pnpm derive && astro build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "astro check && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "vibemath": "node bin/vibemath.mjs",
    "mcp": "tsx mcp/server.ts",
    "doctor": "tsx scripts/doctor.ts",
    "launch": "tsx scripts/launch.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.4",
    "astro": "^5.13.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.1",
    "eslint": "^9.35.0",
    "eslint-plugin-astro": "^1.3.1",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
