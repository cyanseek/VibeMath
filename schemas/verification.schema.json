{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "problem_id": {
      "type": "string",
      "minLength": 1
    },
    "solution_event_id": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "type": "string",
      "enum": [
        "unreviewed",
        "source_audited",
        "site_reproduced",
        "mechanically_verified",
        "lean_checked_statement_unaudited",
        "lean_verified_statement_audited",
        "independent_expert_verified",
        "peer_reviewed",
        "contested",
        "rejected"
      ]
    },
    "mathematical_correctness": {
      "type": "string",
      "enum": [
        "unknown",
        "supported",
        "challenged",
        "rejected"
      ]
    },
    "statement_fidelity": {
      "type": "string",
      "enum": [
        "unknown",
        "unaudited",
        "audited"
      ]
    },
    "peer_review": {
      "type": "string",
      "enum": [
        "none",
        "submitted",
        "reviewed"
      ]
    },
    "verifier": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "verified_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "default": null,
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "label",
          "url",
          "kind",
          "license"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "problem_id",
    "solution_event_id",
    "level",
    "mathematical_correctness",
    "statement_fidelity",
    "peer_review",
    "verifier",
    "verified_at",
    "note",
    "sources"
  ],
  "additionalProperties": false
}
