{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "object",
      "properties": {
        "original": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "default": null,
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "zh_cn": {
          "default": null,
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "original",
        "en",
        "zh_cn"
      ],
      "additionalProperties": false
    },
    "canonical_statement": {
      "type": "string",
      "minLength": 1
    },
    "plain_summary": {
      "type": "string",
      "minLength": 1
    },
    "why_it_matters": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "what_ai_did": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "what_is_verified": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "what_remains_uncertain": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "how_a_non_expert_can_check": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "expert_boundary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "fields": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "posed_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "year_posed": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        {
          "type": "null"
        }
      ]
    },
    "canonical_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "default": null,
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "label",
          "url",
          "kind",
          "license"
        ],
        "additionalProperties": false
      }
    },
    "key_definitions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confusing_variants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "current_status": {
      "type": "string",
      "enum": [
        "open",
        "attempted",
        "partial",
        "candidate",
        "resolved",
        "contested",
        "retracted"
      ]
    },
    "current_status_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source_assertion_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_problem_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    }
  },
  "required": [
    "id",
    "slug",
    "title",
    "canonical_statement",
    "plain_summary",
    "why_it_matters",
    "what_ai_did",
    "what_is_verified",
    "what_remains_uncertain",
    "how_a_non_expert_can_check",
    "expert_boundary",
    "fields",
    "posed_by",
    "year_posed",
    "canonical_sources",
    "key_definitions",
    "confusing_variants",
    "current_status",
    "current_status_confidence",
    "source_assertion_ids",
    "related_problem_ids",
    "updated_at"
  ],
  "additionalProperties": false
}
